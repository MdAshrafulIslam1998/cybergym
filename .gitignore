.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/graph.json
.trash/

# Quartz build output (regenerated by CI)
public/
.quartz-cache/
node_modules/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# Secrets — never commit
.env
.env.*
*.key
*.pem
secrets/

# Drafts not ready for publish
**/_draft_*.md
